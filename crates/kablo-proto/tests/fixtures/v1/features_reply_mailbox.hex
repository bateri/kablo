# features reply: streams on, with the limits of this version, commands on, and a mailbox
8a           # kind 0x8a: features_reply
00           # channel 0: terminal session
00           # session id length 0
00 00 00 33  # payload length 51
00 01        # tlv key 1: streams
00 00 00 01  #   length 1
01           #   streams on
00 03        # tlv key 3: most streams
00 00 00 04  #   length 4
00 00 00 80  #   128 streams at once
00 04        # tlv key 4: largest window
00 00 00 04  #   length 4
01 00 00 00  #   windows up to 16777216 bytes
00 05        # tlv key 5: most data
00 00 00 04  #   length 4
00 00 80 00  #   32768 bytes in a data message
00 06        # tlv key 6: commands
00 00 00 01  #   length 1
01           #   commands on
00 07        # tlv key 7: mailbox
00 00 00 01  #   length 1
01           #   the bridge keeps a mailbox
