# the sender runs in "work"; the client is attached to it, used it 1.5 seconds ago and takes tickets
8c                       # kind 0x8c: ask_reply
00                       # channel 0: terminal session
04                       # session id length 4
00 00 00 1c              # payload length 28
77 6f 72 6b              # session id "work"
00 01                    # tlv key 1: attached
00 00 00 01              #   length 1
01                       #   attached
00 02                    # tlv key 2: idle
00 00 00 08              #   length 8
00 00 00 00 00 00 05 dc  #   1500 milliseconds
00 03                    # tlv key 3: tickets
00 00 00 01              #   length 1
01                       #   the client takes tickets
