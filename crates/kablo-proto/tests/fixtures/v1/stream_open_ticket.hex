# open stream 2 as the answer to ticket 7, ready to take 65536 bytes
01           # kind 0x01: open
01           # channel 1: streams
00           # session id length 0
00 00 00 12  # payload length 18
00 00 00 02  # stream 2
00 01 00 00  # window 65536
00 06        # tlv key 6: ticket
00 00 00 04  #   length 4
00 00 00 07  #   ticket 7
